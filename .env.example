# --- Backend ---
PORT=3001
NODE_ENV=development

# MongoDB Atlas connection string (server-side only)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/tastetrip?retryWrites=true&w=majority

# Qloo API key — used server-side only. Never commit or expose in frontend.
QLOO_API_KEY=your-qloo-api-key-here

# Optional LLM key used to structure raw Qloo results into itineraries.
OPENAI_API_KEY=your-openai-api-key-here

# --- Frontend ---
# Base URL the frontend calls. Defaults to http://localhost:3001 in dev.
VITE_API_BASE_URL=http://localhost:3001